{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://fbovltxucooeoldjfckk.supabase.co https://openfoodfacts.org https://*.openfoodfacts.org; media-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' https://fbovltxucooeoldjfckk.supabase.co wss://fbovltxucooeoldjfckk.supabase.co https://world.openfoodfacts.org; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/supa/(rest|auth|functions)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/supa/storage/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "sandbox; default-src 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/supa/rest/v1/:path*",
      "destination": "https://fbovltxucooeoldjfckk.supabase.co/rest/v1/:path*"
    },
    {
      "source": "/supa/auth/v1/:path*",
      "destination": "https://fbovltxucooeoldjfckk.supabase.co/auth/v1/:path*"
    },
    {
      "source": "/supa/functions/v1/:path*",
      "destination": "https://fbovltxucooeoldjfckk.supabase.co/functions/v1/:path*"
    },
    {
      "source": "/supa/storage/v1/object/public/:path*",
      "destination": "https://fbovltxucooeoldjfckk.supabase.co/storage/v1/object/public/:path*"
    },
    {
      "source": "/promotor/:marca/:codigo",
      "destination": "/index.html"
    }
  ]
}